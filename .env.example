# Copy to .env for native development: `Copy-Item .env.example .env`
# Every value has a working default. The one secret is OPENAI_API_KEY, needed
# only with LLM_PROVIDER=openai. `docker compose up --build` needs no .env at all.

# --- Postgres (docker compose `db` service) ---------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DB_PORT=5432

# --- API and worker ----------------------------------------------------------
# Must match the Postgres settings above. Use 127.0.0.1, not localhost: on
# Windows, localhost costs ~2 s per new connection.
DATABASE_URL=postgresql+asyncpg://app:app@127.0.0.1:5432/app
DB_CONNECT_TIMEOUT_SECONDS=5

# Uploads
MAX_UPLOAD_MB=100
MAX_PAGES=2000

# Ingest worker and job queue. WORKER_ID defaults to <hostname>-<pid>.
# WORKER_ID=
WORKER_POLL_INTERVAL_SECONDS=2
INGEST_BATCH_PAGES=10
JOB_HEARTBEAT_SECONDS=10
# A running job whose heartbeat is older than this is reclaimed by another worker.
JOB_STALE_AFTER_SECONDS=120
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECONDS=30

# Model backends. Fakes need no key and no download (tests, CI).
# LLM_PROVIDER: openai (needs OPENAI_API_KEY) | fake (echoes the prompt, which
#   normally cites nothing, so answers are refused; the whole pipeline still runs)
# EMBEDDER: qwen3-0.6b (Qwen3-Embedding-0.6B, local; ~1.2 GB, downloaded on first use)
#   | fake (hashed words: no download, but vector search ranks are meaningless).
# Vectors are stored with the model that made them; switching models means
# re-chunking (readiness warns which chunks vector search leaves out meanwhile).
LLM_PROVIDER=fake
EMBEDDER=qwen3-0.6b

# OpenAI (https://platform.openai.com/api-keys). Model and reasoning effort per
# role; effort is none | low | medium | high | xhigh | max (not every model takes
# every level). Prices for cost tracking live in services/api/app/pricing.py.
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=60
LLM_ANSWER_MODEL=gpt-6.1-sol
LLM_ANSWER_EFFORT=low
LLM_REWRITE_MODEL=gpt-6-luna
LLM_REWRITE_EFFORT=none
LLM_JUDGE_MODEL=gpt-6-astra
LLM_JUDGE_EFFORT=medium
# Rewrite questions into standalone ones before searching (small model, ~2 s):
# follow_ups (questions with history) | always
QUERY_REWRITE=follow_ups

# DEBUG | INFO | WARNING | ERROR; console (readable) | json (containers)
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Traces (Phoenix) --------------------------------------------------------
# Leave OTEL_TRACES_ENDPOINT empty to turn tracing off.
OTEL_TRACES_ENDPOINT=http://127.0.0.1:6006/v1/traces
OTEL_SERVICE_NAME=api
OTEL_PROJECT_NAME=docs-assistant
PHOENIX_PORT=6006

# --- Web app -----------------------------------------------------------------
# Where the web server reaches the API (server-side only).
API_URL=http://127.0.0.1:8000

# --- Host ports for the full stack (docker compose up) -------------------------
API_PORT=8000
WEB_PORT=3000
