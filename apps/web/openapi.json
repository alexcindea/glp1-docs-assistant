{
  "openapi": "3.1.0",
  "info": {
    "title": "Docs Assistant API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness",
        "operationId": "liveness_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessReport"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            }
          }
        }
      }
    },
    "/documents": {
      "get": {
        "tags": [
          "documents"
        ],
        "summary": "List Documents",
        "operationId": "list_documents_documents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentOut"
                  },
                  "type": "array",
                  "title": "Response List Documents Documents Get"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Upload Document",
        "description": "Check and store a PDF, and queue it for ingestion (202).",
        "operationId": "upload_document_documents_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document_documents_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentOut"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "Already uploaded: the existing document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentOut"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{document_id}": {
      "get": {
        "tags": [
          "documents"
        ],
        "summary": "Get Document",
        "operationId": "get_document_documents__document_id__get",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentOut"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          }
        }
      }
    },
    "/documents/{document_id}/chunks": {
      "get": {
        "tags": [
          "documents"
        ],
        "summary": "List Chunks",
        "description": "The document's chunks in reading order, each with the spans that locate its text.",
        "operationId": "list_chunks_documents__document_id__chunks_get",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChunkOut"
                  },
                  "title": "Response List Chunks Documents  Document Id  Chunks Get"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          }
        }
      }
    },
    "/documents/{document_id}/rechunk": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Rechunk Document",
        "description": "Chunk again from the stored parse (no OCR): seconds, not minutes.\n\nThe document stays `ready` with its current chunks until the new ones replace them.",
        "operationId": "rechunk_document_documents__document_id__rechunk_post",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentOut"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActiveJob": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/JobKind"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running"
            ],
            "title": "Status"
          },
          "pages_done": {
            "type": "integer",
            "title": "Pages Done"
          },
          "pages_total": {
            "type": "integer",
            "title": "Pages Total"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "status",
          "pages_done",
          "pages_total"
        ],
        "title": "ActiveJob"
      },
      "Body_upload_document_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "A PDF"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_documents_post"
      },
      "ChunkOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "seq": {
            "type": "integer",
            "title": "Seq"
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "table"
            ],
            "title": "Kind"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "section_path": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Section Path"
          },
          "token_count": {
            "type": "integer",
            "title": "Token Count"
          },
          "spans": {
            "items": {
              "$ref": "#/components/schemas/SpanOut"
            },
            "type": "array",
            "title": "Spans"
          }
        },
        "type": "object",
        "required": [
          "id",
          "seq",
          "kind",
          "text",
          "section_path",
          "token_count",
          "spans"
        ],
        "title": "ChunkOut"
      },
      "DatabaseStatus": {
        "properties": {
          "reachable": {
            "type": "boolean",
            "title": "Reachable"
          },
          "server_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Server Version"
          },
          "migration_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Migration Revision"
          },
          "expected_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Revision"
          },
          "extensions": {
            "items": {
              "$ref": "#/components/schemas/ExtensionStatus"
            },
            "type": "array",
            "title": "Extensions",
            "default": []
          },
          "problems": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Problems",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "reachable",
          "expected_revision"
        ],
        "title": "DatabaseStatus"
      },
      "DocumentOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count"
          },
          "scanned_pages": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scanned Pages"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "parser": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parser"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "active_job": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActiveJob"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "filename",
          "size_bytes",
          "page_count",
          "scanned_pages",
          "status",
          "error_code",
          "error",
          "parser",
          "created_at",
          "updated_at",
          "active_job"
        ],
        "title": "DocumentOut"
      },
      "DocumentStatus": {
        "type": "string",
        "enum": [
          "queued",
          "processing",
          "ready",
          "failed"
        ],
        "title": "DocumentStatus"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Details",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "ExtensionStatus": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "installed_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Installed Version"
          }
        },
        "type": "object",
        "required": [
          "name",
          "installed_version"
        ],
        "title": "ExtensionStatus"
      },
      "JobKind": {
        "type": "string",
        "enum": [
          "ingest",
          "rechunk"
        ],
        "title": "JobKind"
      },
      "LivenessReport": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "LivenessReport"
      },
      "ModelsStatus": {
        "properties": {
          "llm_provider": {
            "type": "string",
            "title": "Llm Provider"
          },
          "embedder": {
            "type": "string",
            "title": "Embedder"
          },
          "embedding_dimensions": {
            "type": "integer",
            "title": "Embedding Dimensions"
          }
        },
        "type": "object",
        "required": [
          "llm_provider",
          "embedder",
          "embedding_dimensions"
        ],
        "title": "ModelsStatus"
      },
      "ReadinessReport": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus"
          },
          "models": {
            "$ref": "#/components/schemas/ModelsStatus"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "models"
        ],
        "title": "ReadinessReport"
      },
      "SpanOut": {
        "properties": {
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "x0": {
            "type": "number",
            "title": "X0"
          },
          "y0": {
            "type": "number",
            "title": "Y0"
          },
          "x1": {
            "type": "number",
            "title": "X1"
          },
          "y1": {
            "type": "number",
            "title": "Y1"
          },
          "char_start": {
            "type": "integer",
            "title": "Char Start"
          },
          "char_end": {
            "type": "integer",
            "title": "Char End"
          }
        },
        "type": "object",
        "required": [
          "page",
          "x0",
          "y0",
          "x1",
          "y1",
          "char_start",
          "char_end"
        ],
        "title": "SpanOut",
        "description": "A range of the chunk's text and where it sits: page, box (0-1, top-left origin)."
      }
    }
  }
}
