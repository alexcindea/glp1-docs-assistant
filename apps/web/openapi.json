  "components": {
    "schemas": {
      "ActiveJob": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/JobKind"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running"
            ],
            "title": "Status"
          },
          "pages_done": {
            "type": "integer",
            "title": "Pages Done"
          },
          "pages_total": {
            "type": "integer",
            "title": "Pages Total"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "status",
          "pages_done",
          "pages_total"
        ],
        "title": "ActiveJob"
      },
      "AnswerRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "type": "array",
            "maxItems": 10,
            "title": "History"
          },
          "document_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "type": "array",
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Ids"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AnswerRequest"
      },
      "AnswerUsage": {
        "properties": {
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens",
            "default": 0
          },
          "cached_input_tokens": {
            "type": "integer",
            "title": "Cached Input Tokens",
            "default": 0
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens",
            "default": 0
          },
          "reasoning_tokens": {
            "type": "integer",
            "title": "Reasoning Tokens",
            "default": 0
          },
          "cost_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Usd",
            "default": 0.0
          }
        },
        "type": "object",
        "title": "AnswerUsage",
        "description": "Every model call for the question, summed."
      },
      "Body_upload_document_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "A PDF"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_documents_post"
      },
      "ChunkOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "seq": {
            "type": "integer",
            "title": "Seq"
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "table"
            ],
            "title": "Kind"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "section_path": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Section Path"
          },
          "token_count": {
            "type": "integer",
            "title": "Token Count"
          },
          "spans": {
            "items": {
              "$ref": "#/components/schemas/SpanOut"
            },
            "type": "array",
            "title": "Spans"
          }
        },
        "type": "object",
        "required": [
          "id",
          "seq",
          "kind",
          "text",
          "section_path",
          "token_count",
          "spans"
        ],
        "title": "ChunkOut"
      },
      "Citation": {
        "properties": {
          "n": {
            "type": "integer",
            "title": "N"
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "chunk_id": {
            "type": "integer",
            "title": "Chunk Id"
          },
          "section_path": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Section Path"
          },
          "page_start": {
            "type": "integer",
            "title": "Page Start"
          },
          "page_end": {
            "type": "integer",
            "title": "Page End"
          },
          "char_start": {
            "type": "integer",
            "title": "Char Start"
          },
          "char_end": {
            "type": "integer",
            "title": "Char End"
          },
          "spans": {
            "items": {
              "$ref": "#/components/schemas/SpanOut"
            },
            "type": "array",
            "title": "Spans"
          }
        },
        "type": "object",
        "required": [
          "n",
          "document_id",
          "filename",
          "chunk_id",
          "section_path",
          "page_start",
          "page_end",
          "char_start",
          "char_end",
          "spans"
        ],
        "title": "Citation",
        "description": "Passage `n` of the sources, and where to highlight it."
      },
      "DatabaseStatus": {
        "properties": {
          "reachable": {
            "type": "boolean",
            "title": "Reachable"
          },
          "server_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Server Version"
          },
          "migration_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Migration Revision"
          },
          "expected_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Revision"
          },
          "extensions": {
            "items": {
              "$ref": "#/components/schemas/ExtensionStatus"
            },
            "type": "array",
            "title": "Extensions",
            "default": []
          },
          "problems": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Problems",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "reachable",
          "expected_revision"
        ],
        "title": "DatabaseStatus"
      },
      "DeltaEvent": {
        "properties": {
