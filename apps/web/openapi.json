{
  "openapi": "3.1.0",
  "info": {
    "title": "Docs Assistant API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness",
        "operationId": "liveness_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessReport"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness",
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DatabaseStatus": {
        "properties": {
          "reachable": {
            "type": "boolean",
            "title": "Reachable"
          },
          "server_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Server Version"
          },
          "migration_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Migration Revision"
          },
          "expected_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Revision"
          },
          "extensions": {
            "items": {
              "$ref": "#/components/schemas/ExtensionStatus"
            },
            "type": "array",
            "title": "Extensions",
            "default": []
          },
          "problems": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Problems",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "reachable",
          "expected_revision"
        ],
        "title": "DatabaseStatus"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Details",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "ExtensionStatus": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "installed_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Installed Version"
          }
        },
        "type": "object",
        "required": [
          "name",
          "installed_version"
        ],
        "title": "ExtensionStatus"
      },
      "LivenessReport": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "LivenessReport"
      },
      "ModelsStatus": {
        "properties": {
          "llm_provider": {
            "type": "string",
            "title": "Llm Provider"
          },
          "embedder": {
            "type": "string",
            "title": "Embedder"
          },
          "embedding_dimensions": {
            "type": "integer",
            "title": "Embedding Dimensions"
          }
        },
        "type": "object",
        "required": [
          "llm_provider",
          "embedder",
          "embedding_dimensions"
        ],
        "title": "ModelsStatus"
      },
      "ReadinessReport": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus"
          },
          "models": {
            "$ref": "#/components/schemas/ModelsStatus"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "models"
        ],
        "title": "ReadinessReport"
      }
    }
  }
}
